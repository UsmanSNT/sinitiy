{
  "expo": {
    "name": "시니티",
    "slug": "sinity",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sinitymobile",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sinitymobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "게시글에 첨부할 사진을 선택하기 위해 사진 보관함에 접근합니다."
        }
      ],
      "expo-notifications"
    ]
  }
}
