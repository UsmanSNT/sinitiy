{
  "expo": {
    "name": "시니티",
    "slug": "sinity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.itslivingco.sinity",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.itslivingco.sinity",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#182f53"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "게시글에 첨부할 사진을 선택하기 위해 사진 보관함에 접근합니다."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "e6fee5a9-ac77-4335-9b69-d3d7aa2fabaa"
      }
    },
    "owner": "avrangzeb1499"
  }
}
